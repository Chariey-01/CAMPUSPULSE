FLASK_APP=run.py
FLASK_ENV=development

SECRET_KEY=your-secret-key

JWT_SECRET_KEY=your-jwt-secret

DATABASE_URL=postgresql://username:password@localhost:5432/database_name

FRONTEND_URL=http://localhost:5173 /https://campuspulse-two.vercel.app

# Cloudinary - used to sign direct browser-to-Cloudinary uploads (see app/utils/uploads.py).
# api_secret must never be exposed to the frontend; only cloud_name and api_key are public.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
